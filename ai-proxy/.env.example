# ============================================================================
#  ARIA AI Proxy — admin host config. Copy to .env, chmod 600, never commit.
#  The real Google key lives ONLY in this file (data plane), never on team VMs.
# ============================================================================

# Real Google AI Studio key — data plane only. Never copy onto a team-facing host.
GEMINI_API_KEY=AIza-replace-with-your-real-key

# Host interface the DATA-PLANE proxy (:7000) publishes on. Use the admin/VPN-side
# IP so team subnets reach it only through your firewall. NOT 0.0.0.0 in prod.
PROXY_BIND=127.0.0.1

# Admin console port. Always published on the host loopback (127.0.0.1) — reach it
# with:  ssh -L 7700:127.0.0.1:7700 user@<server>
ADMIN_PORT=7700

# Default per-machine rate limits (used when a machine has no explicit limit).
RATE_LIMIT_RPM=30
RATE_LIMIT_DAILY=500

# How long (ms) the data plane caches a key->machine lookup. A revoke/suspend
# takes up to this long to take effect. Default 5000.
KEY_CACHE_TTL_MS=5000

# Force EVERY request to use this model, ignoring whatever the portal asked for.
# Leave blank to honor each portal's GEMINI_MODEL. Example: gemini-2.5-flash-lite
FORCE_MODEL=

# Reject inbound bodies larger than this (bytes). Default 256 KiB.
MAX_BODY_BYTES=262144

# Set to "1" ONLY if a real reverse proxy fronts the data plane. Default 0 so
# callers cannot spoof X-Forwarded-For to dodge per-machine rate limits.
TRUST_PROXY=0

# Optional CSV of source IPs allowed to hit the data plane at all (coarse gate on
# top of the subnet firewall and per-machine IP pins). Matched as a suffix of req.ip.
ALLOWED_ORIGINS=

# NOTE: there is no shared PROXY_TOKEN anymore. Each machine gets its own key:
#   docker compose exec proxy node bin/proxyctl.js key add --label team-1-portal
