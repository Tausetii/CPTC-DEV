# Database
DATABASE_URL="postgresql://wormhole:supernova@db:5432/wormhole?schema=public"

# JWT signing — multiple keys referenced by `kid` (intentionally vulnerable lookup)
JWT_KEY_DIR="./keys"
JWT_DEFAULT_KID="primary"

# Gemini access goes through an off-box proxy (real key lives there, not here)
GEMINI_PROXY_URL="http://10.50.0.10:7000"
GEMINI_PROXY_TOKEN="change-me-shared-bearer"
GEMINI_MODEL="gemini-2.0-flash"

# App
PUBLIC_APP_NAME="ARIA Concierge Portal"
NODE_ENV="development"
ORIGIN="http://localhost:6767"
